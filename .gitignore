# YOLO/Ultralytics outputs
ai_server/runs/

# Latest frames and feed snapshots written at runtime
ai_server/latest_frame.jpg
ai_server/feeds/*.jpg
!ai_server/feeds/default.jpg
!ai_server/feeds/cam_0.jpg
!ai_server/feeds/auto.jpg

# Large model weights downloaded locally (keep project configs in git)
ai_server/weights/
ai_server/*.pt
ai_server/*.onnx
ai_server/*.pth

# If you intentionally commit specific weights, add explicit negations here, e.g.:
# !ai_server/yolov8n.pt
# !ai_server/yolo11n.pt

# --- Local notes ---
pnotes.txt
